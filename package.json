{
  "name": "@payot-inc/toss-ui",
  "version": "0.1.1",
  "description": "Toss Design System (TDS) theme for Nuxt UI",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "nuxt-ui",
    "toss",
    "tds",
    "design-system",
    "tailwindcss"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/payot-inc/toss-ui.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "dev": "nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && nuxt typecheck playground"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.120",
    "@nuxt/kit": "^4.4.8",
    "@nuxt/ui": "^4.10.0",
    "bun": "^1.3.14",
    "defu": "^6.1.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.4.8",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.0",
    "nuxt": "^4.4.8",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.8"
  }
}
